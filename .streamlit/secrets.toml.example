# Esempio di configurazione dei secrets per il MTG Proxy Builder.
#
# In locale: copia questo file in .streamlit/secrets.toml (il file reale è
# escluso da git tramite .gitignore) e imposta i valori.
# Su Streamlit Cloud: incolla il contenuto nella sezione "Secrets" dell'app.
#
# NON inserire mai credenziali reali in questo file di esempio.

[auth]
# Password di accesso all'applicazione (obbligatoria).
app_password = "cambia-questa-password"

# Elenco opzionale di email autorizzate. Se la lista è vuota o assente,
# qualsiasi email è accettata purché la password sia corretta.
allowed_emails = ["operatore@example.com"]
